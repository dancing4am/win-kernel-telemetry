;
; 06-late-driver-monitor.inf
;
; Primitive driver: no device, loaded as a service (sc create / sc start).
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   =
CatalogFile = 06-late-driver-monitor.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
06-late-driver-monitor.sys = 1

[DefaultInstall.NT$ARCH$]
CopyFiles = DriverCopyFiles

[DriverCopyFiles]
06-late-driver-monitor.sys

[DefaultInstall.NT$ARCH$.Services]
AddService = LateDrvMon,0x2,ServiceInstall

[ServiceInstall]
DisplayName   = %ServiceName%
ServiceType   = 1
StartType     = 2
ErrorControl  = 1
ServiceBinary = %13%\06-late-driver-monitor.sys

[Strings]
ManufacturerName = "win-kernel-telemetry"
ServiceName      = "LateDrvMon late-loaded kernel driver monitor"
DiskName         = "06-late-driver-monitor Source Disk"
