;
; 05-image-monitor-async.inf
;
; Primitive driver: no device, loaded as a service (sc create / sc start).
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   =
CatalogFile = 05-image-monitor-async.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
05-image-monitor-async.sys = 1

[DefaultInstall.NT$ARCH$]
CopyFiles = DriverCopyFiles

[DriverCopyFiles]
05-image-monitor-async.sys

[DefaultInstall.NT$ARCH$.Services]
AddService = ImageMonAsync,0x2,ServiceInstall

[ServiceInstall]
DisplayName   = %ServiceName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\05-image-monitor-async.sys

[Strings]
ManufacturerName = "win-kernel-telemetry"
ServiceName      = "ImageMonAsync async image-load monitor"
DiskName         = "05-image-monitor-async Source Disk"
